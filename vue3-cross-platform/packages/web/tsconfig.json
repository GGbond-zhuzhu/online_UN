{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"], // 将 @ 映射到当前 web 子包的 src 目录，方便简写导入路径
      "@campus/common/*": ["../common/src/*"], // 新公共包别名：指向 common 源码子目录
      "@campus/common": ["../common/src/index.ts"], // 新公共包入口：统一从 common 的 index.ts 导出
      "@your-org/common/*": ["../common/src/*"], // 兼容旧别名 your-org/common，仍然指向同一份源码
      "@your-org/common": ["../common/src/index.ts"] // 兼容旧入口 your-org/common
    },
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "5.0" // 忽略 TypeScript 5.x 之前版本的弃用警告，避免无效的 6.0 配置导致编译错误
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["node_modules", "dist"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
