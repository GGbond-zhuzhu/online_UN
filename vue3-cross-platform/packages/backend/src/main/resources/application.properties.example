# ==================== 基本配置 ====================
spring.application.name=backend
server.port=8080

# ==================== 数据库配置 ====================
# 注意：生产环境请使用环境变量或配置文件加密
# 示例：使用环境变量
# spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/campus_db?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai}
# spring.datasource.username=${DB_USERNAME:root}
# spring.datasource.password=${DB_PASSWORD:}

spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/campus_db?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:your_password_here}

# 初始化SQL
# 如果数据库表已存在且结构不匹配，可以暂时改为 never 让应用先启动
# 启动后可以手动执行SQL修复表结构，或者删除表后重新启动应用
spring.sql.init.mode=always
spring.sql.init.schema-locations=classpath:init.sql
# 如果初始化失败，继续启动应用（设置为 true 可以让应用先启动起来，方便查看API文档）
spring.sql.init.continue-on-error=true
# spring.autoconfigure.exclude=org.springframework.boot.autoconfigure.jdbc.DataSourceAutoConfiguration

# ==================== MyBatis-Plus配置 ====================

mybatis-plus.configuration.log-impl=org.apache.ibatis.logging.stdout.StdOutImpl
mybatis-plus.global-config.db-config.id-type=auto
mybatis-plus.type-aliases-package=com.yourschool.campussystem.entity
mybatis-plus.mapper-locations=classpath:mapper/*.xml

# ==================== SpringDoc/Knife4j配置 ====================
# SpringDoc OpenAPI 配置
springdoc.api-docs.enabled=true
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.enabled=true
springdoc.swagger-ui.path=/swagger-ui.html
# 配置API文档分组
springdoc.group-configs[0].group=00-全部接口
springdoc.group-configs[0].paths-to-match=/api/**

# Knife4j配置（4.5.0版本基于SpringDoc）
knife4j.enable=true
knife4j.setting.language=zh_cn
knife4j.setting.enable-version=true
knife4j.setting.enable-footer=true
knife4j.setting.footer-content=校园集成系统API文档
knife4j.setting.enable-document-manage=true
knife4j.setting.enable-home-custom=true
knife4j.production=false
