## 后端数据库环境变量示例（不要提交 .env 到仓库）

# MySQL Root 密码（docker-compose.yml 会用到；Spring Boot 也会读取）
DB_PASSWORD=campus_db_password

# Spring Boot 数据库连接（可选覆盖）
# DB_URL=jdbc:mysql://localhost:3306/campus_db?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
# DB_USERNAME=root

# 第三方服务密钥（可选）
# BAIDU_AI_APP_ID=
# BAIDU_AI_API_KEY=
# BAIDU_AI_SECRET_KEY=
# AMAP_IP_LOCATION_KEY=
# AMAP_IP_LOCATION_SECRET=
# AMAP_WEB_SERVICE_KEY=
# AMAP_WEB_SERVICE_WEB_KEY=
# AMAP_WEB_SERVICE_SECRET_KEY=
# TIANYANCHA_API_TOKEN=

